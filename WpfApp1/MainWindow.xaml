<Window x:Class="PizzaOrder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ пиццы" Height="505" Width="400">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Заказ пиццы" 
                   FontSize="20" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <GroupBox Grid.Row="1" Header="Размер:" Margin="0,0,0,10">
            <StackPanel>
                <RadioButton x:Name="SmallPizza" Content="Маленькая" GroupName="SizeGroup" 
                             IsChecked="True" Margin="5"/>
                <RadioButton x:Name="MediumPizza" Content="Средняя" GroupName="SizeGroup" Margin="5"/>
                <RadioButton x:Name="BigPizza" Content="Большая" GroupName="SizeGroup" Margin="5"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="Добавки:" Margin="0,107,0,24" Grid.RowSpan="2">
            <StackPanel>
                <CheckBox x:Name="CheeseCheckBox" Content="Сыр" Margin="5"/>
                <CheckBox x:Name="MushroomsCheckBox" Content="Грибы" Margin="5"/>
                <CheckBox x:Name="PepperoniCheckBox" Content="Пепперони" Margin="5"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="Количество:" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="QuantitySlider" Minimum="1" Maximum="10" 
                        Width="200" Value="1" 
                        VerticalAlignment="Center" Margin="10,0"/>
                <TextBlock x:Name="QuantityText" Text="1 шт" 
                     VerticalAlignment="Center" Margin="10,0"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="4" Header="Комментарий к заказу:" Margin="0,0,0,10">
            <TextBox x:Name="CommentTextBox" Height="60" 
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     AcceptsReturn="True"/>
        </GroupBox>

        <Button Grid.Row="6" Content="Оформить заказ" 
                Width="120" Height="35" 
                HorizontalAlignment="Center" 
                Click="OrderButton_Click"/>
    </Grid>
</Window>